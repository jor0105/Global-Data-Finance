---
extends: default
rules:
  document-start:
    present: true
  truthy:
    check-keys: false
  line-length:
    # 120 rather than 88: workflow files carry SHA-pinned `uses:` refs and
    # embedded shell/Python in `run:` blocks, neither of which can wrap.
    max: 120
  indentation:
    spaces: 2
