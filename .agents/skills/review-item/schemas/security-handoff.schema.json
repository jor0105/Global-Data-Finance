{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Security Handoff",
  "type": "object",
  "required": [
    "artifactType",
    "schemaVersion",
    "reviewId",
    "status",
    "createdAt",
    "updatedAt",
    "targetAgent",
    "requestedBy",
    "reason",
    "affectedFiles",
    "evidenceIds",
    "gateSummary"
  ],
  "properties": {
    "artifactType": {
      "const": "security-handoff"
    },
    "schemaVersion": {
      "type": "string"
    },
    "reviewId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_review", "cleared", "changes_required", "waived"]
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "targetAgent": {
      "type": "string"
    },
    "requestedBy": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "affectedFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gateSummary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
